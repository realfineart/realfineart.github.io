@font-face
  font-family 'Blackout Midnight'
  src url('webfonts/blackout_midnight-webfont.woff') format('woff2')
  font-weight 900

font-plain = "Figtree", sans-serif
font-block = "Blackout Midnight", sans-serif

html
  font 400 10px/1.6 font-plain
  font-optical-sizing auto
  height 100%

body
  min-height 100%
  font-size 1.7rem
  margin 0

p
  margin 2rem 0

header
  padding 2rem 3rem
  border-bottom 0.5px solid black
  img.logo
    height 6rem

main
  padding 1rem
  margin 0 auto
  max-width 80rem
  display flex
  flex-flow wrap

section
  box-sizing border-box
  margin 1rem
  width calc( 100% - 2rem )
  border-style solid
  border-width 4rem .5rem .5rem
  border-radius 2rem
  padding 0 3rem
  img
    display block
    margin 2rem 0
    width 100%
  > *:last-child
    margin-bottom: 3rem

.about
  border-color #922
.topics
  border-color #365
  width calc( 50% - 2rem )
.contact
  border-color #356
  width calc( 50% - 2rem )
.work
  border-color #444
  .images
    margin-top -2rem
    columns 2
    column-gap 2rem
    column-fill balance
    > *:last-child
      margin-bottom 0

h1
  margin 0
  display flex
  align-items flex-end
  justify-content center
  > small
    margin 0 0 -.3rem 3rem
    font 300 1.8rem/1.1 font-plain
    letter-spacing 8%
    text-transform uppercase

h2
  font 400 3rem/3.5rem font-block
  margin -4rem 0 3rem 0
  padding .5rem 0 0
  text-align center
  color #fffa
  white-space: nowrap;

h3
  font-weight 600
  margin 2rem 0 0

@media (max-width 800px)
  .topics, .contact
    width calc( 100% - 2rem )

@media (max-width 600px)
  body
    font-size 1.5rem
  h1 > img.logo
    height 5rem
  h1 > small
    font-size 1.5rem
    line-height 1.2
  .work .images
    columns 1